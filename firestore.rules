/**
 * @file Firestore Security Rules
 * @core_philosophy This ruleset prioritizes secure data access and prevents unauthorized modification of game content (questions, wildcards, and rules). It assumes that these game content collections are read-only for all users and writable only by an administrative backend. User data is not explicitly secured by these rules.
 * @data_structure The Firestore database consists of three top-level collections: `/questions/{questionId}`, `/wildcards/{wildcardId}`, and `/rules/{ruleId}`.
 * @key_security_decisions This ruleset DENIES all write access (create, update, delete) to the client for the `/questions`, `/wildcards`, and `/rules` collections. This ensures that only a trusted backend can modify the game's core content.  Read access (get, list) is PUBLIC (if true).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read questions, but restricts creation, updating, and deletion.
     * @path /questions/{questionId}
     * @allow (get, list) - Any user can retrieve questions.
     * @deny (create, update, delete) - No user can create, update, or delete questions.
     * @principle Read-only access for questions, preventing unauthorized modifications.
     */
    match /questions/{questionId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read wildcards, but restricts creation, updating, and deletion.
     * @path /wildcards/{wildcardId}
     * @allow (get, list) - Any user can retrieve wildcards.
     * @deny (create, update, delete) - No user can create, update, or delete wildcards.
     * @principle Read-only access for wildcards, preventing unauthorized modifications.
     */
    match /wildcards/{wildcardId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read rules, but restricts creation, updating, and deletion.
     * @path /rules/{ruleId}
     * @allow (get, list) - Any user can retrieve rules.
     * @deny (create, update, delete) - No user can create, update, or delete rules.
     * @principle Read-only access for rules, preventing unauthorized modifications.
     */
    match /rules/{ruleId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}