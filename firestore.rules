/**
 * @file Firestore Security Rules
 * @description This ruleset enforces public read access for questions, wildcards, and rules while restricting write access.
 *
 * Data Structure:
 * - /questions/{questionId}: Stores trivia questions.
 * - /wildcards/{wildcardId}: Stores wildcard cards.
 * - /rules/{ruleId}: Stores game rules.
 *
 * Key Security Decisions:
 * - Questions, Wildcards and Rules are publicly readable.
 * - All writes are denied.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read trivia questions, but nobody to modify them.
     * @path /questions/{questionId}
     * @allow (get, list): Any user can read a question.
     * @deny (create, update, delete): No user can create, update, or delete a question.
     * @principle Public read, no write access.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read wildcard cards, but nobody to modify them.
     * @path /wildcards/{wildcardId}
     * @allow (get, list): Any user can read a wildcard card.
     * @deny (create, update, delete): No user can create, update, or delete a wildcard card.
     * @principle Public read, no write access.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read game rules, but nobody to modify them.
     * @path /rules/{ruleId}
     * @allow (get, list): Any user can read a rule.
     * @deny (create, update, delete): No user can create, update, or delete a rule.
     * @principle Public read, no write access.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}