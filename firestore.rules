/**
 * @file Firestore Security Rules for PTG Application
 * @corePhilosophy This ruleset prioritizes security by enforcing strict read-only access to game content (questions, wildcards, rules).
 *   It is designed to prevent unauthorized modifications while allowing public access to game data. User data is not stored so user authentication only matters for future write access.
 * @dataStructure The Firestore database consists of three top-level collections: 'questions', 'wildcards', and 'rules'.
 *   Each collection contains documents representing individual game elements.
 * @keySecurityDecisions All write operations are denied to prevent unauthorized modifications of game content.
 *   Read access is open to all users, including unauthenticated users.
 *   Listing of collections is allowed so the client can fetch all data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to questions, but prohibits any write operations.
     * @path /questions/{questionId}
     * @allow (get, list) - Any user, authenticated or not, can read the question.
     * @deny (create, update, delete) - No user can create, update, or delete questions.
     * @principle Allows public read access while preventing unauthorized modifications of game questions.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public read access to wildcards, but prohibits any write operations.
     * @path /wildcards/{wildcardId}
     * @allow (get, list) - Any user, authenticated or not, can read the wildcard.
     * @deny (create, update, delete) - No user can create, update, or delete wildcards.
     * @principle Allows public read access while preventing unauthorized modifications of game wildcards.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public read access to rules, but prohibits any write operations.
     * @path /rules/{ruleId}
     * @allow (get, list) - Any user, authenticated or not, can read the game rule.
     * @deny (create, update, delete) - No user can create, update, or delete game rules.
     * @principle Allows public read access while preventing unauthorized modifications of game rules.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}