/**
 * @file Firestore Security Rules
 * @core-philosophy This ruleset allows public read access to game content (questions, wildcards, rules)
 * while restricting write access to prevent unauthorized modifications. Data validation is minimized
 * for rapid prototyping.
 * @data-structure The database consists of three top-level collections: `/questions/{questionId}`,
 * `/wildcards/{wildcardId}`, and `/rules/{ruleId}`.
 * @key-security-decisions Public read access is granted for all collections. Write access is denied
 * to prevent unauthorized modifications. There is no user specific data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read questions, but restricts creation, updates, and deletion.
     * @path /questions/{questionId}
     * @allow (get, list) - Any user can read question documents.
     * @deny (create, update, delete) - No one can create, update, or delete question documents.
     * @principle Allows public reads and disallows writes
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read wildcards, but restricts creation, updates, and deletion.
     * @path /wildcards/{wildcardId}
     * @allow (get, list) - Any user can read wildcard documents.
     * @deny (create, update, delete) - No one can create, update, or delete wildcard documents.
     * @principle Allows public reads and disallows writes
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read game rules, but restricts creation, updates, and deletion.
     * @path /rules/{ruleId}
     * @allow (get, list) - Any user can read rule documents.
     * @deny (create, update, delete) - No one can create, update, or delete rule documents.
     * @principle Allows public reads and disallows writes
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}