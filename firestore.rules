/**
 * @fileoverview Firestore Security Rules for PTG application.
 *
 * Core Philosophy:
 * This ruleset provides public read access to questions, wildcards, and rules,
 * while restricting write access to prevent unauthorized modifications.
 *
 * Data Structure:
 * The database consists of three top-level collections:
 * - /questions/{questionId}: Stores trivia questions.
 * - /wildcards/{wildcardId}: Stores wildcard cards.
 * - /rules/{ruleId}: Stores game rules.
 *
 * Key Security Decisions:
 * - Public Read Access: All users (authenticated or not) can read questions, wildcards, and rules.
 * - Restricted Write Access: Only authenticated users can create, update, or delete questions, wildcards, and rules.
 *   However, the rules do NOT include any role-based access control or ownership validation. This should be updated ASAP.
 * - No User Listing: There are no rules defined for a /users collection, so listing users is implicitly denied.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to questions and restricts write access to authenticated users.
     * @path /questions/{questionId}
     * @allow (get, list): Any user can read questions.
     * @allow (create, update, delete): Only authenticated users can create, update, or delete questions.
     * @deny (create, update, delete): Unauthenticated users cannot create, update, or delete questions.
     * @principle Allows public read access while restricting write operations.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Grants public read access to wildcards and restricts write access to authenticated users.
     * @path /wildcards/{wildcardId}
     * @allow (get, list): Any user can read wildcards.
     * @allow (create, update, delete): Only authenticated users can create, update, or delete wildcards.
     * @deny (create, update, delete): Unauthenticated users cannot create, update, or delete wildcards.
     * @principle Allows public read access while restricting write operations.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Grants public read access to rules and restricts write access to authenticated users.
     * @path /rules/{ruleId}
     * @allow (get, list): Any user can read rules.
     * @allow (create, update, delete): Only authenticated users can create, update, or delete rules.
     * @deny (create, update, delete): Unauthenticated users cannot create, update, or delete rules.
     * @principle Allows public read access while restricting write operations.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // No rules defined for `/batch operation`

    /**
     * @description Helper function to determine if a user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }
  }
}