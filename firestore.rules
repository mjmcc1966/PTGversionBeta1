/**
 * @file Firestore Security Rules
 * @description This ruleset defines access control for the PTG (Party Trivia Game) application.
 *
 * Core Philosophy:
 * The ruleset provides open read access to game content (questions, wildcards, rules)
 * to facilitate game play while restricting write access. No user-specific data is secured.
 *
 * Data Structure:
 * - /questions/{questionId}: Stores trivia questions. Read access is public; write access is restricted.
 * - /wildcards/{wildcardId}: Stores wildcard cards. Read access is public; write access is restricted.
 * - /rules/{ruleId}: Stores game rules. Read access is public; write access is restricted.
 *
 * Key Security Decisions:
 * - Public Read Access: The rules explicitly allow public read access (`get`, `list`) for the `questions`, `wildcards`, and `rules` collections. This is appropriate for game content intended for all users.
 * - No User Listing: No user data is stored, so there are no user listing concerns.
 * - Write Restrictions: All write operations (`create`, `update`, `delete`) are denied to prevent unauthorized modification of game content. This is a secure default.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * @description Allows anyone to read questions, but restricts creation, updates, and deletion.
     * @path /questions/{questionId}
     * @allow (get, list) Anyone can read questions.
     * @deny (create, update, delete) No one can create, update, or delete questions.
     * @principle Public read access for game content.
     */
    match /questions/{questionId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read wildcards, but restricts creation, updates, and deletion.
     * @path /wildcards/{wildcardId}
     * @allow (get, list) Anyone can read wildcards.
     * @deny (create, update, delete) No one can create, update, or delete wildcards.
     * @principle Public read access for game content.
     */
    match /wildcards/{wildcardId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read rules, but restricts creation, updates, and deletion.
     * @path /rules/{ruleId}
     * @allow (get, list) Anyone can read rules.
     * @deny (create, update, delete) No one can create, update, or delete rules.
     * @principle Public read access for game content.
     */
    match /rules/{ruleId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}