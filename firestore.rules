/**
 * @fileoverview Firestore Security Rules for PTG application.
 *
 * Core Philosophy:
 * This ruleset provides open read access to game content (questions, wildcards, rules)
 * but strictly restricts write access to prevent unauthorized modifications.
 *
 * Data Structure:
 * - /questions/{questionId}: Stores trivia questions.
 * - /wildcards/{wildcardId}: Stores wildcard cards.
 * - /rules/{ruleId}: Stores game rules.
 *
 * Key Security Decisions:
 * - Open read access for questions, wildcards, and rules.
 * - Write access is completely disabled for all collections in this prototype.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read questions, but no one to create, update, or delete them.
     * @path /questions/{questionId}
     * @allow (get, list) Anyone can read questions.
     * @deny (create, update, delete) No one can create, update, or delete questions.
     * @principle Provides open read access to game content while preventing unauthorized modifications.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read wildcards, but no one to create, update, or delete them.
     * @path /wildcards/{wildcardId}
     * @allow (get, list) Anyone can read wildcards.
     * @deny (create, update, delete) No one can create, update, or delete wildcards.
     * @principle Provides open read access to game content while preventing unauthorized modifications.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read rules, but no one to create, update, or delete them.
     * @path /rules/{ruleId}
     * @allow (get, list) Anyone can read rules.
     * @deny (create, update, delete) No one can create, update, or delete rules.
     * @principle Provides open read access to game content while preventing unauthorized modifications.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}