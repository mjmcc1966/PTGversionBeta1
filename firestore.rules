rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check for admin privileges
    function isAdmin() {
      return request.auth.token.isAdmin == true;
    }

    // Questions can be read by anyone.
    match /questions/{questionId} {
      allow get: if true;
      allow list: if true;
      allow write: if isAdmin();
    }

    // Wildcards can be read and written by anyone for now.
    match /wildcards/{wildcardId} {
      allow get: if true;
      allow list: if true;
      allow write: if true;
    }

    // Rules can be read by anyone.
    match /rules/{ruleId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }

    // A publicly readable collection to store non-sensitive counts.
    match /counts/{countId} {
        allow get: if true;
        allow write: if isAdmin(); // Only admins can update counts
    }

    // Users can read and write to their own user document.
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId;
    }
  }
}
