/**
 * @fileoverview Firestore Security Rules for PTG application.
 *
 * Core Philosophy:
 * This ruleset enforces public read access for game content (questions, wildcards, rules)
 * while restricting write access to prevent unauthorized modifications.
 *
 * Data Structure:
 * - /questions/{questionId}: Stores trivia questions.
 * - /wildcards/{wildcardId}: Stores wildcard cards.
 * - /rules/{ruleId}: Stores game rules.
 *
 * Key Security Decisions:
 * - Questions, wildcards, and rules are publicly readable.
 * - Write access to questions, wildcards, and rules is denied to all users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to questions and denies all write access.
     * @path /questions/{questionId}
     * @allow (get, list): Any user can read questions.
     * @deny (create, update, delete): No user can create, update, or delete questions.
     * @principle Allows public reads, but restricts writes.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Grants public read access to wildcards and denies all write access.
     * @path /wildcards/{wildcardId}
     * @allow (get, list): Any user can read wildcards.
     * @deny (create, update, delete): No user can create, update, or delete wildcards.
     * @principle Allows public reads, but restricts writes.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Grants public read access to rules and denies all write access.
     * @path /rules/{ruleId}
     * @allow (get, list): Any user can read rules.
     * @deny (create, update, delete): No user can create, update, or delete rules.
     * @principle Allows public reads, but restricts writes.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}