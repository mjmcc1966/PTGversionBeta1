/**
 * @fileoverview Firestore Security Rules for PTG application.
 *
 * Core Philosophy:
 * This ruleset provides public read access to game content (questions, wildcards, rules)
 * while restricting write access to prevent unauthorized modifications.
 *
 * Data Structure:
 * - /questions/{questionId}: Stores trivia questions.
 * - /wildcards/{wildcardId}: Stores wildcard cards.
 * - /rules/{ruleId}: Stores game rules.
 *
 * Key Security Decisions:
 * - Public read access for questions, wildcards, and rules.
 * - No write permissions granted in this initial configuration.
 *   (Write permissions might be granted to admin roles later in the development).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read trivia questions, but restricts creation, updates, and deletion.
     * @path /questions/{questionId}
     * @allow (get, list) Anyone can read questions.
     * @deny (create, update, delete) No one can create, update, or delete questions.
     * @principle Provides public read access while preventing unauthorized modifications.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read wildcard cards, but restricts creation, updates, and deletion.
     * @path /wildcards/{wildcardId}
     * @allow (get, list) Anyone can read wildcards.
     * @deny (create, update, delete) No one can create, update, or delete wildcards.
     * @principle Provides public read access while preventing unauthorized modifications.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read game rules, but restricts creation, updates, and deletion.
     * @path /rules/{ruleId}
     * @allow (get, list) Anyone can read rules.
     * @deny (create, update, delete) No one can create, update, or delete rules.
     * @principle Provides public read access while preventing unauthorized modifications.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}