/**
 * @fileoverview Firestore Security Rules for PTG application.
 *
 * Core Philosophy:
 * This ruleset provides public read access to game content (questions, wildcards, and rules)
 * while restricting write access to prevent unauthorized modifications. All authenticated users can read
 * and list these collections, but write access is explicitly denied.  User data (if implemented) would
 * follow an ownership model, but user documents are not part of the provided data model.
 *
 * Data Structure:
 * - /questions/{questionId}: Stores trivia questions.
 * - /wildcards/{wildcardId}: Stores wildcard cards.
 * - /rules/{ruleId}: Stores game rules.
 *
 * Key Security Decisions:
 * - Public read access to game content.
 * - No write access granted through these rules. Write access requires separate privileged backend.
 * - User-specific data is not part of this data model.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to trivia questions, but restricts all write operations.
     * @path /questions/{questionId}
     * @allow (get, list) Any authenticated user can read or list questions.
     * @deny (create, update, delete) No user can create, update, or delete questions through the client.
     * @principle Public read access with no client-side writes.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to wildcard cards, but restricts all write operations.
     * @path /wildcards/{wildcardId}
     * @allow (get, list) Any authenticated user can read or list wildcards.
     * @deny (create, update, delete) No user can create, update, or delete wildcards through the client.
     * @principle Public read access with no client-side writes.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to game rules, but restricts all write operations.
     * @path /rules/{ruleId}
     * @allow (get, list) Any authenticated user can read or list rules.
     * @deny (create, update, delete) No user can create, update, or delete rules through the client.
     * @principle Public read access with no client-side writes.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}