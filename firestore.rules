/**
 * @fileoverview Firestore Security Rules for PTG application.
 *
 * Core Philosophy:
 * This ruleset provides public read access to game content (questions, wildcards, and rules) while restricting write access to prevent unauthorized modifications.
 *
 * Data Structure:
 * The database consists of three top-level collections: /questions/{questionId}, /wildcards/{wildcardId}, and /rules/{ruleId}. These collections are designed to store static game content.
 *
 * Key Security Decisions:
 * - Public Read Access: All game content is publicly readable to enable easy access for all users without authentication.
 * - Write Restrictions: All write operations (create, update, delete) are strictly denied to prevent unauthorized modification of game data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to questions, while denying all write operations.
     * @path /questions/{questionId}
     * @allow (get, list) Any user can read questions.
     * @deny (create, update, delete) No user can create, update, or delete questions.
     * @principle Allows public read access for game content while restricting unauthorized modifications.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to wildcards, while denying all write operations.
     * @path /wildcards/{wildcardId}
     * @allow (get, list) Any user can read wildcards.
     * @deny (create, update, delete) No user can create, update, or delete wildcards.
     * @principle Allows public read access for game content while restricting unauthorized modifications.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to rules, while denying all write operations.
     * @path /rules/{ruleId}
     * @allow (get, list) Any user can read rules.
     * @deny (create, update, delete) No user can create, update, or delete rules.
     * @principle Allows public read access for game content while restricting unauthorized modifications.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}