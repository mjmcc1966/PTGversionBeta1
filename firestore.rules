/**
 * @file Firestore Security Rules
 * @description This ruleset enforces read-only access to game content (questions, wildcards, rules) for all users and restricts write access.
 *
 * Core Philosophy:
 *  - Public read access to game content.
 *  - No write access for regular users; writes are implicitly disallowed.
 *
 * Data Structure:
 *  - Top-level collections for questions, wildcards, and rules.
 *  - No user-specific data or subcollections.
 *
 * Key Security Decisions:
 *  - No user listing allowed.
 *  - Write operations are denied for all collections, effectively making them read-only from the application perspective. This ensures data integrity and prevents unauthorized modification of game content.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to trivia questions.
     * @path /questions/{questionId}
     * @allow (get, list) Anyone can read questions.
     * @deny (create, update, delete) No one can create, update, or delete questions.
     * @principle Allows public access for reads, restricts all writes.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to wildcard cards.
     * @path /wildcards/{wildcardId}
     * @allow (get, list) Anyone can read wildcards.
     * @deny (create, update, delete) No one can create, update, or delete wildcards.
     * @principle Allows public access for reads, restricts all writes.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to game rules.
     * @path /rules/{ruleId}
     * @allow (get, list) Anyone can read rules.
     * @deny (create, update, delete) No one can create, update, or delete rules.
     * @principle Allows public access for reads, restricts all writes.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}