/**
 * @fileoverview Firestore Security Rules for PTG Application
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing read-only access to game content
 * (questions, wildcards, rules). No user-generated content is currently supported,
 * so all write operations are disabled to prevent unauthorized data modification.
 *
 * Data Structure:
 * The database consists of three top-level collections: 'questions', 'wildcards', and 'rules'.
 * Each collection contains documents representing game elements, identified by unique IDs.
 *
 * Key Security Decisions:
 * - All data is considered read-only.
 * - Unauthenticated reads are allowed for all collections.
 * - No write access is granted to any client, authenticated or otherwise.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to questions, but denies all writes.
     * @path /questions/{questionId}
     * @allow (get, list) - Any user can read a question.
     * @deny (create, update, delete) - No user can create, update, or delete a question.
     * @principle Allows public read, but restricts all write access.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to wildcards, but denies all writes.
     * @path /wildcards/{wildcardId}
     * @allow (get, list) - Any user can read a wildcard.
     * @deny (create, update, delete) - No user can create, update, or delete a wildcard.
     * @principle Allows public read, but restricts all write access.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to rules, but denies all writes.
     * @path /rules/{ruleId}
     * @allow (get, list) - Any user can read a rule.
     * @deny (create, update, delete) - No user can create, update, or delete a rule.
     * @principle Allows public read, but restricts all write access.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}