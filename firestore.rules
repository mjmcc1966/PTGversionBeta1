/**
 * @file Firestore Security Rules
 * @description This ruleset enforces public read access to game content (questions, wildcards, rules)
 *   while restricting write access to prevent unauthorized modifications.
 *
 * Data Structure:
 * - /questions/{questionId}: Stores individual trivia questions.
 * - /wildcards/{wildcardId}: Stores wildcard cards.
 * - /rules/{ruleId}: Stores the game rules.
 *
 * Key Security Decisions:
 * - Public Read Access: Questions, wildcards, and rules are publicly readable to facilitate game play.
 * - No User-Generated Content: The application does not support user-generated content. Therefore,
 *   creation, updating, and deletion of questions, wildcards, and rules are strictly prohibited
 *   via the client.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to questions. No write access allowed from client.
     * @path /questions/{questionId}
     * @allow (get, list) Any user can read questions.
     * @deny (create, update, delete) No user can create, update, or delete questions.
     * @principle Allows public access for reads, restricts all writes.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to wildcards. No write access allowed from client.
     * @path /wildcards/{wildcardId}
     * @allow (get, list) Any user can read wildcards.
     * @deny (create, update, delete) No user can create, update, or delete wildcards.
     * @principle Allows public access for reads, restricts all writes.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to game rules. No write access allowed from client.
     * @path /rules/{ruleId}
     * @allow (get, list) Any user can read game rules.
     * @deny (create, update, delete) No user can create, update, or delete game rules.
     * @principle Allows public access for reads, restricts all writes.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}