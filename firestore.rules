/**
 * @file Firestore Security Rules
 * @description This ruleset configures access control for the PTG application's Firestore database.
 *
 * Core Philosophy:
 * The ruleset defaults to open read access for all data, but restricts write access to prevent unauthorized modifications.
 *
 * Data Structure:
 * - /questions/{questionId}: Stores trivia questions. Publicly readable.
 * - /wildcards/{wildcardId}: Stores wildcard cards. Publicly readable.
 * - /rules/{ruleId}: Stores game rules. Publicly readable.
 *
 * Key Security Decisions:
 * - Read access is generally open to allow clients to fetch game content.
 * - Write access is denied across all collections to prevent unauthorized data modification.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the 'questions' collection.
     * @path /questions/{questionId}
     * @allow (get, list): Any user can read questions.
     * @deny (create, update, delete): No user can create, update, or delete questions.
     * @principle Allows public reads, denies all writes.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to the 'wildcards' collection.
     * @path /wildcards/{wildcardId}
     * @allow (get, list): Any user can read wildcards.
     * @deny (create, update, delete): No user can create, update, or delete wildcards.
     * @principle Allows public reads, denies all writes.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to the 'rules' collection.
     * @path /rules/{ruleId}
     * @allow (get, list): Any user can read rules.
     * @deny (create, update, delete): No user can create, update, or delete rules.
     * @principle Allows public reads, denies all writes.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}