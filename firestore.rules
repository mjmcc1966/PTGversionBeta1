/**
 * @file Firestore Security Rules
 * @description This ruleset defines access control for the PTG application's Firestore database.
 *
 * Core Philosophy:
 * The ruleset provides public read access to game content (questions, wildcards, rules)
 * while restricting write access to prevent unauthorized modifications. This allows anyone to
 * read the game content without authentication, but only authorized users or processes
 * (not defined here) could potentially modify the content.
 *
 * Data Structure:
 * The database contains three top-level collections: `questions`, `wildcards`, and `rules`.
 * Each collection stores documents representing game content.
 *
 * Key Security Decisions:
 * - Public read access: `get` and `list` operations are allowed for all users, including
 *   unauthenticated users, on all three collections.
 * - Write restrictions: `create`, `update`, and `delete` operations are denied to all users.
 *   This enforces read-only access for the game content.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read questions, but nobody to create, update, or delete them.
     * @path /questions/{questionId}
     * @allow (get, list) - Any user can read questions.
     * @deny (create, update, delete) - No user can create, update, or delete questions.
     * @principle Allows public access to read questions, and restricts all users from writing.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read wildcards, but nobody to create, update, or delete them.
     * @path /wildcards/{wildcardId}
     * @allow (get, list) - Any user can read wildcards.
     * @deny (create, update, delete) - No user can create, update, or delete wildcards.
     * @principle Allows public access to read wildcards, and restricts all users from writing.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read rules, but nobody to create, update, or delete them.
     * @path /rules/{ruleId}
     * @allow (get, list) - Any user can read rules.
     * @deny (create, update, delete) - No user can create, update, or delete rules.
     * @principle Allows public access to read rules, and restricts all users from writing.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}