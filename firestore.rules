/**
 * @fileoverview Firestore Security Rules for PTG application.
 *
 * Core Philosophy:
 * This ruleset provides open read access for questions, wildcards, and rules, while restricting all write access (create, update, delete) to prevent unauthorized data modification.
 *
 * Data Structure:
 * The data is organized into three top-level collections: `/questions/{questionId}`, `/wildcards/{wildcardId}`, and `/rules/{ruleId}`.
 *
 * Key Security Decisions:
 * - Questions, wildcards and rules can be read by anyone.
 * - No write operations (create, update, delete) are permitted on questions, wildcards or rules. This protects the core game data from accidental or malicious modification.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read questions, but forbids any writes.
     * @path /questions/{questionId}
     * @allow (get, list) Any user can retrieve questions.
     * @deny (create, update, delete) No user can create, update or delete questions.
     * @principle Provides open read access while preventing unauthorized data modification.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read wildcards, but forbids any writes.
     * @path /wildcards/{wildcardId}
     * @allow (get, list) Any user can retrieve wildcards.
     * @deny (create, update, delete) No user can create, update or delete wildcards.
     * @principle Provides open read access while preventing unauthorized data modification.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read rules, but forbids any writes.
     * @path /rules/{ruleId}
     * @allow (get, list) Any user can retrieve rules.
     * @deny (create, update, delete) No user can create, update or delete rules.
     * @principle Provides open read access while preventing unauthorized data modification.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}