/**
 * @fileoverview Firestore Security Rules for PTG application.
 *
 * Core Philosophy:
 * This ruleset provides public read access to game content (questions, wildcards, rules)
 * but prevents unauthorized data modification. It does not enforce any authorization
 * at all for writes for prototyping speed. This should not be used in production.
 *
 * Data Structure:
 * - /questions/{questionId}: Stores trivia questions.
 * - /wildcards/{wildcardId}: Stores wildcard cards.
 * - /rules/{ruleId}: Stores game rules.
 *
 * Key Security Decisions:
 * - Public read access to all game content collections.
 * - No write authorization for questions, wildcards, or rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to questions.
     * @path /databases/{database}/documents/questions/{questionId}
     * @allow (get, list)
     * @deny (create)
     * @deny (update)
     * @deny (delete)
     * @principle Allows anyone to read questions, but prevents unauthorized creation, updates, or deletions.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to wildcards.
     * @path /databases/{database}/documents/wildcards/{wildcardId}
     * @allow (get, list)
     * @deny (create)
     * @deny (update)
     * @deny (delete)
     * @principle Allows anyone to read wildcards, but prevents unauthorized creation, updates, or deletions.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to game rules.
     * @path /databases/{database}/documents/rules/{ruleId}
     * @allow (get, list)
     * @deny (create)
     * @deny (update)
     * @deny (delete)
     * @principle Allows anyone to read the game rules, but prevents unauthorized creation, updates, or deletions.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}