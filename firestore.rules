/**
 * @fileoverview Firestore Security Rules for PTG application.
 *
 * Core Philosophy:
 * This ruleset provides public read access to questions, wildcards, and rules,
 * while strictly prohibiting write access to ensure data integrity.
 *
 * Data Structure:
 * - /questions/{questionId}: Collection of trivia questions.
 * - /wildcards/{wildcardId}: Collection of wildcard cards.
 * - /rules/{ruleId}: Collection of game rules.
 *
 * Key Security Decisions:
 * - Read-only collections for questions, wildcards, and rules.
 * - Write operations are denied to prevent unauthorized modifications.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to questions, but prohibits any writes.
     * @path /questions/{questionId}
     * @allow (get, list) Allows any user to read questions.
     * @deny (create, update, delete) Prevents any user from creating, updating, or deleting questions.
     * @principle Provides public access for reads and restricts all writes to protect questions data.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to wildcards, but prohibits any writes.
     * @path /wildcards/{wildcardId}
     * @allow (get, list) Allows any user to read wildcards.
     * @deny (create, update, delete) Prevents any user from creating, updating, or deleting wildcards.
     * @principle Provides public access for reads and restricts all writes to protect wildcards data.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to rules, but prohibits any writes.
     * @path /rules/{ruleId}
     * @allow (get, list) Allows any user to read rules.
     * @deny (create, update, delete) Prevents any user from creating, updating, or deleting rules.
     * @principle Provides public access for reads and restricts all writes to protect rules data.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}