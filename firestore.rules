/**
 * @fileoverview Firestore Security Rules for PTG application.
 *
 * Core Philosophy:
 * This ruleset provides public read access to game content (questions, wildcards, and rules)
 * while restricting write access to prevent unauthorized modifications. It does not include any private user data.
 *
 * Data Structure:
 * The database consists of three top-level collections:
 * - /questions/{questionId}: Stores trivia questions.
 * - /wildcards/{wildcardId}: Stores wildcard cards.
 * - /rules/{ruleId}: Stores game rules.
 *
 * Key Security Decisions:
 * - Public Read Access: All documents in the `/questions`, `/wildcards`, and `/rules` collections are publicly readable.
 * - No User Data: This ruleset does not handle any private user-specific data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to questions. Writes are disallowed.
     * @path /questions/{questionId}
     * @allow (get, list) Public access to retrieve any question.
     * @deny (create, update, delete) No one can create, update, or delete questions.
     * @principle Allows open reads, restricts all writes.
     */
    match /questions/{questionId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public read access to wildcards. Writes are disallowed.
     * @path /wildcards/{wildcardId}
     * @allow (get, list) Public access to retrieve any wildcard.
     * @deny (create, update, delete) No one can create, update, or delete wildcards.
     * @principle Allows open reads, restricts all writes.
     */
    match /wildcards/{wildcardId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public read access to game rules. Writes are disallowed.
     * @path /rules/{ruleId}
     * @allow (get, list) Public access to retrieve any rule.
     * @deny (create, update, delete) No one can create, update, or delete rules.
     * @principle Allows open reads, restricts all writes.
     */
    match /rules/{ruleId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}