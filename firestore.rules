/**
 * @fileoverview Firestore Security Rules for PTG application.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing a public-read, owner-write model
 * for core game data (questions, wildcards, rules). This allows for open access to
 * game content while restricting modifications to authorized users. User data is
 * completely unrestricted in this prototyping phase.
 *
 * Data Structure:
 * - /questions/{questionId}: Stores trivia questions. Publicly readable, owner-only writeable.
 * - /wildcards/{wildcardId}: Stores wildcard cards. Publicly readable, owner-only writeable.
 * - /rules/{ruleId}: Stores game rules. Publicly readable, owner-only writeable.
 *
 * Key Security Decisions:
 * - Public Read Access: All main game content (questions, wildcards, rules) is
 *   publicly readable to facilitate game access.
 * - Owner-Only Writes: Creation, modification, and deletion of game content are
 *   restricted to an owner. However, the application currently lacks the required "ownerId"
 *   field in the entities. Rules for this are created as a TODO and must be implemented.
 *
 * Denormalization for Authorization:
 * The ruleset anticipates an `ownerId` field on the Question, Wildcard, and Rule entities.
 * Once these fields are added to the data model, the rules can be updated to enforce
 * ownership based on `request.auth.uid`.
 *
 * Structural Segregation:
 * The application currently stores questions, wildcards, and rules in top-level collections
 * intended for public consumption.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to questions and restricts writes to owners.
     * @path /questions/{questionId}
     * @allow (get, list): Any user can read questions.
     * @allow (create): Not Allowed yet, requires `ownerId` property in the data.
     * @allow (update): Not Allowed yet, requires `ownerId` property in the data and must match existing document.
     * @allow (delete): Not Allowed yet, requires `ownerId` property in the data and must match existing document.
     * @deny (create): if true, until `ownerId` field is implemented in the data model.
     * @deny (update): if true, until `ownerId` field is implemented in the data model.
     * @deny (delete): if true, until `ownerId` field is implemented in the data model.
     * @principle Allows public reads, requires data model update to enforce ownership on writes.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows public read access to wildcards and restricts writes to owners.
     * @path /wildcards/{wildcardId}
     * @allow (get, list): Any user can read wildcards.
     * @allow (create): Not Allowed yet, requires `ownerId` property in the data.
     * @allow (update): Not Allowed yet, requires `ownerId` property in the data and must match existing document.
     * @allow (delete): Not Allowed yet, requires `ownerId` property in the data and must match existing document.
     * @deny (create): if true, until `ownerId` field is implemented in the data model.
     * @deny (update): if true, until `ownerId` field is implemented in the data model.
     * @deny (delete): if true, until `ownerId` field is implemented in the data model.
     * @principle Allows public reads, requires data model update to enforce ownership on writes.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows public read access to rules and restricts writes to owners.
     * @path /rules/{ruleId}
     * @allow (get, list): Any user can read rules.
     * @allow (create): Not Allowed yet, requires `ownerId` property in the data.
     * @allow (update): Not Allowed yet, requires `ownerId` property in the data and must match existing document.
     * @allow (delete): Not Allowed yet, requires `ownerId` property in the data and must match existing document.
     * @deny (create): if true, until `ownerId` field is implemented in the data model.
     * @deny (update): if true, until `ownerId` field is implemented in the data model.
     * @deny (delete): if true, until `ownerId` field is implemented in the data model.
     * @principle Allows public reads, requires data model update to enforce ownership on writes.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}