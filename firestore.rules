/**
 * @fileoverview Firestore Security Rules for PTG application.
 *
 * Core Philosophy:
 * This ruleset provides public read access to game content (questions, wildcards, and rules)
 * while restricting write access to prevent unauthorized modifications. It does not implement
 * any user-specific data or access controls beyond authentication.
 *
 * Data Structure:
 * The database consists of three top-level collections: `/questions/{questionId}`,
 * `/wildcards/{wildcardId}`, and `/rules/{ruleId}`.  There is no user-specific data.
 *
 * Key Security Decisions:
 * - Public Read Access: All game content is readable by any user, authenticated or not.
 * - No User Listing: There are no rules for user-specific collections or user listing.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read questions, but restricts creation, updates, and deletion.
     * @path /questions/{questionId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Allows public reads, restricts writes.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read wildcards, but restricts creation, updates, and deletion.
     * @path /wildcards/{wildcardId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Allows public reads, restricts writes.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read rules, but restricts creation, updates, and deletion.
     * @path /rules/{ruleId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Allows public reads, restricts writes.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}