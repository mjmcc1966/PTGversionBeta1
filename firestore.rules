/**
 * @file Firestore Security Rules for PTG Application
 *
 * @core Philosophy:
 * This ruleset provides public read access to questions, wildcards, and rules,
 * while restricting write access to prevent unauthorized modifications.
 *
 * @data Structure:
 * The database consists of three top-level collections:
 * - /questions/{questionId}: Stores individual trivia questions.
 * - /wildcards/{wildcardId}: Stores wildcard cards.
 * - /rules/{ruleId}: Stores the game rules.
 *
 * @key Security Decisions:
 * - Read-only access for all users (including unauthenticated users) to game content.
 * - No write access for standard users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read questions, but restricts creation, updates, and deletions.
     * @path /questions/{questionId}
     * @allow (get, list): Any user (or no user) can read a question.
     * @deny (create, update, delete): No one can create, update, or delete a question.
     * @principle Public read, no write access.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read wildcards, but restricts creation, updates, and deletions.
     * @path /wildcards/{wildcardId}
     * @allow (get, list): Any user (or no user) can read a wildcard.
     * @deny (create, update, delete): No one can create, update, or delete a wildcard.
     * @principle Public read, no write access.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read game rules, but restricts creation, updates, and deletions.
     * @path /rules/{ruleId}
     * @allow (get, list): Any user (or no user) can read a game rule.
     * @deny (create, update, delete): No one can create, update, or delete a game rule.
     * @principle Public read, no write access.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}