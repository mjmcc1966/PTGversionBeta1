/**
 * @file Firestore Security Rules
 * @description This ruleset enforces read-only access to game content (questions, wildcards, rules) for all users.
 *   No write access is granted, ensuring the integrity of the game's core data.
 *
 * @dataStructure
 * - /questions/{questionId}: Stores trivia questions.
 * - /wildcards/{wildcardId}: Stores wildcard cards.
 * - /rules/{ruleId}: Stores game rules.
 *
 * @keySecurityDecisions
 * - All game content collections are read-only.
 * - No user-specific data is stored, so no ownership-based rules are needed.
 * - List operations are allowed for all users to facilitate game content discovery.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read the questions, but restricts all write operations.
     * @path /questions/{questionId}
     * @allow (get, list) Any user can retrieve or list questions.
     * @deny (create, update, delete) No user can create, update, or delete questions.
     * @principle Public read access with no write access to ensure game content integrity.
     */
    match /questions/{questionId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read the wildcards, but restricts all write operations.
     * @path /wildcards/{wildcardId}
     * @allow (get, list) Any user can retrieve or list wildcards.
     * @deny (create, update, delete) No user can create, update, or delete wildcards.
     * @principle Public read access with no write access to ensure game content integrity.
     */
    match /wildcards/{wildcardId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read the game rules, but restricts all write operations.
     * @path /rules/{ruleId}
     * @allow (get, list) Any user can retrieve or list game rules.
     * @deny (create, update, delete) No user can create, update, or delete game rules.
     * @principle Public read access with no write access to ensure game content integrity.
     */
    match /rules/{ruleId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}