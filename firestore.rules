/**
 * @fileoverview Firestore Security Rules for PTG Application
 *
 * Core Philosophy:
 * This ruleset prioritizes ease of iteration by focusing on strict access control and minimal data validation.
 * It assumes that all data management is handled by trusted backend processes.
 * All collections are publicly readable. Write access is forbidden.
 *
 * Data Structure:
 * - `/questions/{questionId}`: Stores trivia questions.
 * - `/wildcards/{wildcardId}`: Stores wildcard cards.
 * - `/rules/{ruleId}`: Stores game rules.
 *
 * Key Security Decisions:
 * - Public Read Access: All data is considered publicly readable to facilitate easy data display in the application.
 * - No User Data: There are no users or private data in this prototype.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read trivia questions, but prevents anyone from creating, updating, or deleting them.
     * @path /questions/{questionId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Public read access with no write access.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read wildcard cards, but prevents anyone from creating, updating, or deleting them.
     * @path /wildcards/{wildcardId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Public read access with no write access.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read game rules, but prevents anyone from creating, updating, or deleting them.
     * @path /rules/{ruleId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Public read access with no write access.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}