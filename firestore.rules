/**
 * @fileoverview Firestore Security Rules for PTG Application
 *
 * Core Philosophy:
 * This ruleset prioritizes ease of iteration by focusing on strict authorization
 * while relaxing data validation.  It enforces read and write access controls
 * based on the type of data (public vs. private). Data structure is not strictly enforced,
 * but data relationships and authorization-relevant fields are validated.
 *
 * Data Structure:
 * - /questions/{questionId}: Public collection of trivia questions.
 * - /wildcards/{wildcardId}: Public collection of wildcard cards.
 * - /rules/{ruleId}: Public collection of game rules.
 *
 * Key Security Decisions:
 * - Questions, wildcards, and rules are considered public and accessible to all users.
 * - Schema validation is relaxed to allow for quick iteration.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read questions, but restricts modifications.
     * @path /questions/{questionId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Allows public read access to questions.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read wildcards, but restricts modifications.
     * @path /wildcards/{wildcardId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Allows public read access to wildcards.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read rules, but restricts modifications.
     * @path /rules/{ruleId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Allows public read access to game rules.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}