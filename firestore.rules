/**
 * @file Firestore Security Rules
 * @description This ruleset enforces public read access to game content (questions, wildcards, rules) while restricting write access entirely.
 *
 * Data Structure:
 * All data resides in top-level collections: /questions/{questionId}, /wildcards/{wildcardId}, and /rules/{ruleId}.
 * There is no user-specific data or subcollections.
 *
 * Key Security Decisions:
 * - Public Read Access: All users, including unauthenticated users, can read all questions, wildcards, and rules.
 * - No Write Access: No users can create, update, or delete any questions, wildcards, or rules through the client. Write operations are intended to be managed through a separate administrative interface.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read trivia questions, but prohibits writing.
     * @path /questions/{questionId}
     * @allow (get, list) - Any user can read any question.
     * @deny (create, update, delete) - No user can create, update, or delete a question.
     * @principle Allows public read access while restricting write access.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read wildcards, but prohibits writing.
     * @path /wildcards/{wildcardId}
     * @allow (get, list) - Any user can read any wildcard.
     * @deny (create, update, delete) - No user can create, update, or delete a wildcard.
     * @principle Allows public read access while restricting write access.
     */
    match /wildcards/{wildcardId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read game rules, but prohibits writing.
     * @path /rules/{ruleId}
     * @allow (get, list) - Any user can read any rule.
     * @deny (create, update, delete) - No user can create, update, or delete a rule.
     * @principle Allows public read access while restricting write access.
     */
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}