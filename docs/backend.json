{
  "entities": {
    "Question": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Question",
      "type": "object",
      "description": "Represents a question within the PTG application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the question."
        },
        "category": {
            "type": "string",
            "description": "The category of the question."
        },
        "question": {
          "type": "string",
          "description": "The text of the question."
        },
        "options": {
          "type": "array",
          "description": "An array of possible answers.",
          "items": {
            "type": "string"
          }
        },
        "correctAnswer": {
          "type": "string",
          "description": "The correct answer to the question."
        },
        "explanation": {
          "type": "string",
          "description": "Explanation for the correct answer."
        },
        "imageUrl": {
          "type": "string",
          "description": "Optional URL for an image related to the question."
        }
      },
      "required": [
        "id",
        "question",
        "options",
        "correctAnswer",
        "explanation",
        "category"
      ]
    },
    "Wildcard": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Wildcard",
      "type": "object",
      "description": "Represents a wildcard card in the game.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the wildcard."
        },
        "category": {
          "type": "string",
          "description": "The category of the wildcard."
        },
        "text": {
          "type": "string",
          "description": "The text of the wildcard."
        }
      },
      "required": [
        "id",
        "category",
        "text"
      ]
    },
    "Rule": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Rule",
      "type": "object",
      "description": "Represents a section of the game rules.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifier for the rule section (e.g., 'general-game-play')."
        },
        "title": {
          "type": "string",
          "description": "The title of the rule section."
        },
        "content": {
          "type": "array",
          "description": "An array of paragraphs or list items for the rule section.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["id", "title", "content"]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the PTG application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "username": {
          "type": "string",
          "description": "The user's username."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        }
      },
      "required": [
        "id",
        "username",
        "email"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/questions/{questionId}": {
      "schema": {
        "$ref": "#/entities/Question"
      },
      "description": "Stores all trivia questions for the game."
    },
    "/wildcards/{wildcardId}": {
      "schema": {
        "$ref": "#/entities/Wildcard"
      },
      "description": "Stores all wildcard cards for the game."
    },
    "/rules/{ruleId}": {
      "schema": {
        "$ref": "#/entities/Rule"
      },
      "description": "Stores the game rules, organized by section."
    }
  }
}